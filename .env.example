# ===== Agent Platform 环境配置示例 =====
# 复制为 .env 并填入真实值。settings.ts 的 envSchema 是权威变量清单。

# LLM：多套模型用 ACTIVE_MODEL 切换（值=组前缀小写：deepseek / glm）。
# 选中组的 _API_KEY/_MODEL/_BASE_URL 会被映射进 settings.DEEPSEEK_*，消费代码无需改动。
# 多步工具密集型任务推荐 glm（GLM 5.2 基本无幻觉）；deepseek-v4-flash 偶有"上下文变重后偷懒编造"。
ACTIVE_MODEL=glm

# --- DeepSeek（ACTIVE_MODEL=deepseek 时启用）---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=http://your-deepseek-host:port/v1
# 思考强度（可选）：deepseek-v4-flash 网关默认不返回思考体，需显式传 reasoning_effort 触发。
# 有效值 none/minimal/low/medium/high/xhigh；GLM 默认出思考且不认此参数，留空即不传。
# REASONING_EFFORT=medium

# --- 智谱 GLM（ACTIVE_MODEL=glm 时启用）---
GLM_API_KEY=
GLM_MODEL=glm-5.2
GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4

# --- Runtime ---
RUNTIME_PORT=9876
RUNTIME_HOST=127.0.0.1
# 必须设 true：禁用 CopilotKit 遥测，保留 DatabaseAgentRunner 的本地 /threads* 端点能力。
COPILOTKIT_TELEMETRY_DISABLED=true

# --- 日志落盘（JSONL，符合《高质量日志规范》§3/§12）---
# env 字段取值：development / production 等（记进每条日志的 env）
NODE_ENV=development
# debug/info/warn/error/fatal；=debug 时错误 stack 也会落盘
LOG_LEVEL=info
# 输出目录（相对进程 cwd），主日志 logs/agent-platform.log，错误另写 logs/agent-platform.error.log
LOG_DIR=logs
# 日志文件保留天数（区别于 RETENTION_DAYS：那是 DB 事件/审计 TTL）
LOG_RETENTION_DAYS=30
# 单文件轮转上限（MB），加上按天轮转双触发
LOG_MAX_MB=10

# --- 数据库（同一 MSSQL 实例）---
# DB_NAME      = 业务库（db_demo NL2SQL 查询，走 db.ts:getPool）
# HARNESS_DB_NAME = 中台自有状态库（事件/线程/审计/artifact/摘要，走 Prisma）
DB_HOST=192.168.0.9
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_NAME=ai_platform_db
HARNESS_DB_NAME=ai_harness_db
# Prisma datasource（prisma migrate CLI 读 process.env 此值；运行时由 settings 拼同值）。
# 密码含特殊字符（: \ = ; / [ ]）时用 {...} 包裹或 URL 编码。
HARNESS_DATABASE_URL=sqlserver://DB_HOST:1433;database=ai_harness_db;user=DB_USER;password=DB_PASSWORD;encrypt=false;trustServerCertificate=true;schema=dbo;connectTimeout=5;socketTimeout=15;poolTimeout=10
# TTL 清理：事件/审计/artifact 保留天数（缺省 30）
RETENTION_DAYS=30

# --- 鉴权 ---
JWT_SECRET=change-me

# --- 观察控制台（/console、/observe/stream）---
# 默认开启；设 OBSERVE_ENABLED=false 关闭（注意 env 是字符串，"false" 才生效）。
OBSERVE_ENABLED=true
# 可选 admin token；配置后 /observe/stream 与 /console/api/* 需带 ?token= 或 Authorization。
OBSERVE_TOKEN=
